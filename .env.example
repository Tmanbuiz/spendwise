# SpendWise environment template.
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Only publishable, client-safe values belong here. The Supabase service-role
# key is NOT in this list and must never ship in the app — it bypasses Row
# Level Security. Keep it server-side only.

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- App ----------------------------------------------------------------
# local | staging | production
APP_ENV=local

# Default currency for banks that omit a currency code in their alerts.
DEFAULT_CURRENCY=CAD

# Minutes within which two identical notifications are treated as one event.
DUPLICATE_WINDOW_MINUTES=10

# Days a redacted unparsed notification sample is kept before purging.
RAW_SAMPLE_RETENTION_DAYS=30

# --- Bank data aggregator (optional) ------------------------------------
# Set to true once you have a Plaid or Flinks account AND have deployed the
# Edge Functions in supabase/functions/. Until then the feature stays hidden.
AGGREGATOR_ENABLED=false

# plaid | flinks
AGGREGATOR_PROVIDER=plaid
#
# NOTE: no aggregator secret appears here, and none ever should. PLAID_SECRET
# grants the ability to pull a linked bank account without the user present,
# so it lives only in Supabase Edge Function secrets:
#
#   supabase secrets set PLAID_CLIENT_ID=... PLAID_SECRET=... PLAID_ENV=sandbox
#
# Anything in this file ships inside the APK and can be extracted from it.

# --- Never store any of the following, anywhere, in any form ------------
# online banking passwords, PINs, CVVs, full card numbers.
# The parser extracts at most the last four digits of a card.
