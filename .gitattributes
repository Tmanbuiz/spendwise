# Normalise line endings so a checkout on another machine does not show every
# file as modified. Git stores LF; Windows working copies get CRLF where the
# tool below expects it.
* text=auto eol=lf

# Windows-only tooling that genuinely wants CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.pdf binary

# Generated: keep it out of diffs and out of language statistics.
app/pubspec.lock linguist-generated=true
