# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example
*.keystore
*.jks
key.properties
android/key.properties
ios/Runner/GoogleService-Info.plist
android/app/google-services.json

# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
# The app is an application, so its lockfile is committed — that is what makes
# a clone build the same versions this one did. The parser is a library
# consumed by path, and a library's lockfile binds nothing on its consumer.
packages/*/pubspec.lock
coverage/
doc/api/

# Android
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
*.iml

# iOS / macOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
**/.DS_Store

# IDE
.idea/
.vscode/*
!.vscode/launch.json
*.swp

# Supabase local
supabase/.branches/
supabase/.temp/

# IDE project metadata generated by flutter create
app/.idea/
